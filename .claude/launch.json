{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "salahkar-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "salahkar-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "port": 8000
    }
  ]
}

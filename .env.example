RAZORPAY_KEY_SECRET=

# AI call billing, calculated in the browser (not by the agent).
# First N minutes are free, then each started minute debits the wallet.
NEXT_PUBLIC_AGENT_FREE_MINUTES=5
NEXT_PUBLIC_AGENT_RUPEES_PER_MINUTE=10

# Public site metadata
NEXT_PUBLIC_SITE_NAME=MySalahkaar

# The MySalahkar API (backend/) is served on this site's origin under /api/v1. On AWS the load balancer routes
# /api/v1/* to the API, so leave API_ORIGIN empty there. Set it only when Next.js must proxy the API itself:
# Amplify-style hosting, or local `npm run dev`.
API_ORIGIN=                    # local Node API: http://localhost:8000

# Auth0 (Regular Web Application in the dev tenant; see backend/README.md). Server-side only.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=                  # tenant domain without https://, e.g. mysalahkar-dev.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=                  # openssl rand -hex 32
AUTH0_AUDIENCE=https://api.mysalahkar.com   # the API identifier; must match the API's AUTH0_AUDIENCE

# Every other secret (Razorpay, Vibrium, My Mudra, email) lives in the API's configuration, not here.

# Public site metadata
NEXT_PUBLIC_SITE_NAME=MySalahkaar
NEXT_PUBLIC_SITE_URL=https://mysalahkar.com
